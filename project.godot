config_version=5

[application]

config/name="SimpleCards"
run/main_scene="uid://brvun6l03k0hu"
config/features=PackedStringArray("4.5", "GL Compatibility")
config/icon="res://github/assets/simple_card_v2.png"

[autoload]

CG="*res://addons/simple_cards/card_global.gd"

[display]

window/size/viewport_width=1280
window/size/viewport_height=720
window/stretch/mode="canvas_items"

[editor_plugins]

enabled=PackedStringArray("res://addons/simple_cards/plugin.cfg")

